 IDS_USAGE03,         "  -k, --keepuuid            保留源磁盘创建 UUID。\015\012"
 IDS_USAGE04,         "  -e, --enlarge <大小>      增大虚拟容量（MB/GB）。\015\012"
 IDS_USAGE05,         "  -r, --repart              同时增大主分区。\015\012"
 IDS_USAGE06,         "  -c, --compact             丢弃受支持文件系统的未使用块。\015\012"
 IDS_USAGE07,         "\015\012原地修改选项：\015\012"
 IDS_USAGE08,         "  -i, --inplace             直接修改受支持的源 VDI。\015\012"
 IDS_USAGE09,         "      --force-encrypted     加密警告后仍允许原地修改。\015\012"
 IDS_USAGE10,         "      --resume              继续未完成的原地恢复日志。\015\012"
